| makeresults count=12
| streamstats count as test_case
| eval sample=split("%5Cpostex_a1b2c3d4|%5C%5C.%5Cpipe%5Cmsagent_aabbccdd|POSTEX_ABCD1234|%5Cpostex_ssh_1234abcd|%5CMSSE-1234-server|%5CSIEMLabControl_20261107|postex_not_hex|mypostex_a1b2c3d4|postex_a1b2.exe|msagent_|MSSE-abc-server|%20","|")
| eval pipe_name=trim(urldecode(mvindex(sample,test_case-1))), expected_match=if(test_case<=5,1,0)
| eval pipe_leaf=lower(mvindex(split(pipe_name,urldecode("%5C")),-1))
| eval actual_match=if(match(pipe_leaf,"^(?:msagent_[0-9a-f]+|postex_(?:ssh_)?[0-9a-f]+|msse-[0-9]+-server)$"),1,0)
| eval result=if(actual_match=expected_match,"PASS","FAIL")
| table test_case pipe_name pipe_leaf expected_match actual_match result
