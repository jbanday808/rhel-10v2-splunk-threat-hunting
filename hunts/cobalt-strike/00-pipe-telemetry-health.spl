index=sysmon host=WINHUNT01
| eval code=tonumber(coalesce(EventCode,EventID)), pipe=coalesce(PipeName,pipe_name)
| stats count as events count(eval(code=1)) as process_created
    count(eval(code=17)) as pipe_created count(eval(code=18)) as pipe_connected
    count(eval((code=17 OR code=18) AND isnotnull(pipe) AND pipe!="")) as named_pipe_events
    max(_time) as latest_event
