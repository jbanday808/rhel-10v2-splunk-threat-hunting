(index=win_security OR index=win_system OR index=powershell OR index=sysmon OR index=linux OR index=lab) earliest=-24h
| stats count max(_time) as last_event max(_indextime) as last_recv perc95(eval(_indextime-_time)) as p95_s by index host sourcetype
| eval idle_s=now()-last_recv
| convert ctime(last_*)
