# These do NOT overwrite original six lab indexes.
[net_zeek]
homePath = $SPLUNK_DB/net_zeek/db
coldPath = $SPLUNK_DB/net_zeek/colddb
thawedPath = $SPLUNK_DB/net_zeek/thaweddb
